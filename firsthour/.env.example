# ── Anthropic ────────────────────────────────────────────────
# Server-side only. NEVER expose this to the browser.
ANTHROPIC_API_KEY=

# Model routing (verify current IDs at platform.claude.com/docs before deploy).
# Sonnet tier: agent conversation, Phase 1 analysis, tailoring, cover letters.
# Haiku tier: triage, title canonicalization, dedup, no-AI-policy scan, freshness parsing.
FIRSTHOUR_MODEL_SONNET=claude-sonnet-4-6
FIRSTHOUR_MODEL_HAIKU=claude-haiku-4-5-20251001

# ── Supabase ─────────────────────────────────────────────────
# FirstHour reuses the existing "Dap_app" project but lives in its OWN `firsthour` schema
# with `firsthour_`-prefixed tables — it never touches public or other apps' tables.
# Project ref: obpbpffietooawdizree
NEXT_PUBLIC_SUPABASE_URL=https://obpbpffietooawdizree.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only (service role — full DB access, never expose to browser).
SUPABASE_SERVICE_ROLE_KEY=

# ── Job search provider (v1) ─────────────────────────────────
# Provider is pluggable (lib/jobs/provider.ts). "serper" | "serpapi" | "mock".
JOBS_PROVIDER=mock
SERPER_API_KEY=
SERPAPI_KEY=

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret guarding cron route handlers.
CRON_SECRET=
